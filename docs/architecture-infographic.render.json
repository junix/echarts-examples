    {
      "id": "render-pipeline",
      "title": "渲染管线 · 从 TypeScript 源到透明 PNG 全离线闭环",
      "grammar": "spine + round trips",
      "stages": [
        {"id": "p1", "name": "TS 源码", "input": "main.ts"},
        {"id": "p2", "name": "类型检查", "detail": "tsc --noEmit"},
        {"id": "p3", "name": "Vite 构建", "detail": "vite build"},
        {"id": "p4", "name": "本地服务", "detail": "127.0.0.1:4175"},
        {"id": "p5", "name": "浏览器渲染", "detail": "Playwright + Chrome"},
        {"id": "p6", "name": "PNG 输出", "output": "out/*.png"}
      ],
      "round_trips": [
        {"from": "p3", "to": "Vite Dev Server", "call": "构建产物", "reply": "HTTP 提供"},
        {"from": "p4", "to": "Playwright + Chrome", "call": "加载页面", "reply": "截图结果"}
      ],
      "boundary": "本地回环 · 无外网"
    },
    {
      "id": "quality-gates",
      "title": "质量验证 · 三重断言确保每个场景都真的渲染出来了",
      "gates": [
        {
          "id": "g1",
          "name": "类型检查",
          "kind": "静态",
          "checks": ["tsc --noEmit", "校验 12 个 EChartsOption 类型", "scene 路由表完整性"]
        },
        {
          "id": "g2",
          "name": "交互契约",
          "kind": "运行时",
          "checks": ["等待 __VIS_READY__ 标志", "注入 pointer 事件", "验证 __INTERACTION_COUNT__ 递增"]
        },
        {
          "id": "g3",
          "name": "RGBA 像素断言",
          "kind": "像素级",
          "checks": ["透明像素 > 8%", "可见像素 > 3.5%", "彩色像素 > 2500", "防止空白 / 纯黑输出"]
        }
      ]
    },
    {
      "id": "tech-stack",
      "title": "技术栈",
      "columns": [
        {"name": "运行时", "items": ["echarts 6.1.0", "Canvas 渲染器", "透明背景设计"]},
